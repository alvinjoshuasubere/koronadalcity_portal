# City of Koronadal public page routing (supports root and localhost subfolders).
Options -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Redirect direct browser GET requests to clean public page URLs only.
# Do not redirect API endpoints, AJAX requests, PHP includes, or form submissions.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+[^?\s]*?/index\.php[?\s] [NC]
RewriteRule ^index\.php$ ./ [R=302,L,NE]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+[^?\s]*?/(city-officials|mayor-corner|emergency-contacts)\.php[?\s] [NC]
RewriteRule ^(city-officials|mayor-corner|emergency-contacts)\.php$ $1 [R=302,L,NE]

# Resolve only the site's three clean public information pages.
RewriteRule ^(city-officials|mayor-corner|emergency-contacts)/?$ $1.php [L,QSA,NC]

# Non-page PHP scripts should not be accessed as public pages.
<FilesMatch "^(?:city-live-panel|barangay-map|shared-footer)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "^(?:\.env|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>
